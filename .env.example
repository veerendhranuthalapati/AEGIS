# AEGIS — copy to .env and set strong values for non-local use.
# Never commit .env files.

# Core
ENVIRONMENT=development
SECRET_KEY=
DATABASE_URL=postgresql+asyncpg://aegis:change-me@127.0.0.1:5433/aegis
UPSTREAM_BASE_URL=http://127.0.0.1:8100

# Optional LLM upstream (default: mock — no external API)
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_ANALYZER_ENABLED=false
LLM_ANALYZER_PROVIDER=none

# Docker Compose overrides
AEGIS_SECRET_KEY=
AEGIS_POSTGRES_PASSWORD=

# Seed users (development only)
AEGIS_ADMIN_PASSWORD=
AEGIS_OPERATOR_PASSWORD=
